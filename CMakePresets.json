{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "mingw-debug",
            "displayName": "MinGW x64 Debug",
            "description": "MinGW-w64 / Qt MinGW 6.10.3 / Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/mingw-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_PREFIX_PATH": "D:/Qt/6.10.3/mingw_64",
                "CMAKE_C_COMPILER": "D:/Qt/Tools/mingw1310_64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "D:/Qt/Tools/mingw1310_64/bin/g++.exe"
            }
        },
        {
            "name": "mingw-release",
            "displayName": "MinGW x64 Release",
            "description": "MinGW-w64 / Qt MinGW 6.10.3 / Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/mingw-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_PREFIX_PATH": "D:/Qt/6.10.3/mingw_64",
                "CMAKE_C_COMPILER": "D:/Qt/Tools/mingw1310_64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "D:/Qt/Tools/mingw1310_64/bin/g++.exe"
            }
        }
    ],
    "buildPresets": [
        { "name": "mingw-debug",   "configurePreset": "mingw-debug" },
        { "name": "mingw-release", "configurePreset": "mingw-release" }
    ]
}
