/* =====================================================
   AlgeMate Light Theme - 清新紫色学习风
   主色 #6A5AE0 | 背景 #F6F7FB | 卡片 #FFFFFF
   ===================================================== */

/* 全局 */
* {
    font-family: "Microsoft YaHei UI", "PingFang SC", "Segoe UI", sans-serif;
    color: #1F2033;
    outline: none;
}

QWidget {
    background-color: transparent;
}

QMainWindow, QDialog {
    background-color: #F6F7FB;
}

/* ---------- 顶部 TitleBar ---------- */
QWidget#TitleBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECEEF5;
}
QLabel#AppTitle {
    color: #1F2033;
    font-size: 18px;
    font-weight: 700;
}
QLabel#AppSubtitle {
    color: #8A8FA3;
    font-size: 12px;
    font-weight: 400;
}
QLabel#AppVersion {
    color: #B4B8CC;
    font-size: 11px;
}

/* ---------- 左侧 NavigationBar ---------- */
QWidget#NavigationBar {
    background-color: #FFFFFF;
    border-right: 1px solid #ECEEF5;
}
QLabel#NavBrand {
    color: #6A5AE0;
    font-size: 16px;
    font-weight: 800;
    padding: 18px 20px 8px 20px;
}
QListWidget#NavList {
    background: transparent;
    border: none;
    padding: 8px 10px;
    font-size: 14px;
}
QListWidget#NavList::item {
    height: 44px;
    padding-left: 16px;
    border-radius: 10px;
    color: #4A4D66;
    margin: 2px 4px;
}
QListWidget#NavList::item:hover {
    background-color: #F1EEFF;
    color: #6A5AE0;
}
QListWidget#NavList::item:selected {
    background-color: #EBE5FF;
    color: #6A5AE0;
    font-weight: 600;
    border-left: 3px solid #6A5AE0;
    padding-left: 13px;
}

/* ---------- 右侧内容卡片 ---------- */
QFrame#Card, QWidget#Card {
    background-color: #FFFFFF;
    border: 1px solid #ECEEF5;
    border-radius: 14px;
}

/* ---------- HomePage 功能卡片 ---------- */
QFrame#QuickCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
}
QFrame#QuickCard:hover {
    background-color: #F8F9FC;
    border: 1px solid #6B7CFF;
}
QLabel#QuickCardTitle {
    font-size: 16px;
    font-weight: 700;
    color: #2D3748;
    background: transparent;
}
QLabel#QuickCardDesc {
    font-size: 12px;
    color: #8A8FA3;
    background: transparent;
}

/* ---------- HomePage 学习计划卡片 ---------- */
QFrame#GoalFrame {
    background-color: #FAFAFC;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
}
QFrame#GoalFrame:hover {
    border-color: #6B7CFF;
    background-color: #F8F9FC;
}
QLabel#GoalTitle {
    font-size: 16px; font-weight: 700; color: #333333;
    background: transparent; border: none;
}
QLabel#GoalPercent {
    font-size: 14px; font-weight: 700; color: #6B7CFF;
    background: transparent; border: none;
}
QPushButton#GoalSecondaryBtn {
    background: #FFFFFF; border: 1px solid #E2E8F0; color: #4A5568;
    font-size: 12px; font-weight: bold; border-radius: 14px; padding: 6px 12px;
}
QPushButton#GoalSecondaryBtn:hover {
    background: #F7FAFC; color: #6B7CFF; border-color: #6B7CFF;
}

QLabel#PageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #1F2033;
}
QLabel#PageSubtitle {
    font-size: 13px;
    color: #8A8FA3;
}
QLabel#PlaceholderLabel {
    font-size: 16px;
    color: #8A8FA3;
    font-weight: 500;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E1E4EE;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 28px;
    color: #4A4D66;
    font-size: 13px;
}
QPushButton:hover {
    border-color: #6A5AE0;
    color: #6A5AE0;
}
QPushButton:pressed {
    background-color: #F1EEFF;
}
QPushButton:checked {
    background-color: #6A5AE0;
    border-color: #6A5AE0;
    color: #FFFFFF;
}
QPushButton[primary="true"] {
    background-color: #6A5AE0;
    border: 1px solid #6A5AE0;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton[primary="true"]:hover {
    background-color: #7E70E6;
    border-color: #7E70E6;
}
QPushButton[primary="true"]:pressed {
    background-color: #5849C9;
}

/* ================= Learning 模块 ================= */
QTreeWidget#KnowledgeTree {
    background-color: #FFFFFF;
    border: 1px solid #ECEEF5;
    border-radius: 14px;
    padding: 8px;
    font-size: 14px;
    color: #1F2033;
}
QTreeWidget#KnowledgeTree::item {
    height: 38px;
    padding-left: 10px;
    border-radius: 8px;
}
QTreeWidget#KnowledgeTree::item:selected {
    background-color: #F1EEFF;
    color: #6A5AE0;
    font-weight: 600;
}
QTreeWidget#KnowledgeTree::item:hover {
    background-color: #F6F7FB;
}
QTextBrowser#KnowledgeContent {
    background-color: #FFFFFF;
    border: 1px solid #ECEEF5;
    border-radius: 14px;
    padding: 14px 18px;
    color: #1F2033;
}
QPushButton#LearnBackBtn {
    background-color: #F6F7FB;
    border: 1px solid #E1E4EE;
    border-radius: 10px;
    padding: 8px 22px;
    min-height: 36px;
    color: #4A4D66;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#LearnBackBtn:hover {
    background-color: #F1EEFF;
    border-color: #6A5AE0;
    color: #6A5AE0;
}

/* 图标式圆按钮（TitleBar 主题切换等） */
QPushButton[iconBtn="true"] {
    background-color: #F6F7FB;
    border: 1px solid transparent;
    border-radius: 16px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
    font-size: 14px;
}
QPushButton[iconBtn="true"]:hover {
    background-color: #EBE5FF;
    color: #6A5AE0;
}
QPushButton[iconBtn="true"]:checked {
    background-color: #EBE5FF;
    color: #6A5AE0;
    border-color: #6A5AE0;
}

/* ---------- 输入框 ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #E1E4EE;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 26px;
    selection-background-color: #6A5AE0;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #6A5AE0;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #D6D9E6;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #A8ADC3;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background: #D6D9E6;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: #A8ADC3; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- 分隔 / 其他 ---------- */
QFrame[role="separator"] {
    background-color: #ECEEF5;
    max-height: 1px;
    min-height: 1px;
    border: none;
}
QStatusBar {
    background: #FFFFFF;
    border-top: 1px solid #ECEEF5;
    color: #8A8FA3;
}
QToolTip {
    background-color: #1F2033;
    color: #FFFFFF;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
}

/* ================= AI 解题模块 ================= */
QLabel#AiPageTitle {
    font-size: 20px;
    font-weight: bold;
    color: #4c1d95;
    background: transparent;
}
QLabel#AiPageSubtitle {
    color: #6b7280;
    font-size: 13px;
    background: transparent;
}
QLabel#AiStatusLabel {
    color: #10b981;
    font-size: 12px;
    font-weight: bold;
    background: transparent;
}
LatexTextBrowser#AiResultView, QTextBrowser#AiResultView, QTextEdit#AiResultView {
    background-color: #fbfbfe;
    border: 1px solid #e0dced;
    border-radius: 12px;
    padding: 12px;
    color: #333333;
    selection-background-color: #d8b4e2;
}
QTextEdit#AiInputEdit {
    background-color: #ffffff;
    border: 1px solid #e0dced;
    border-radius: 8px;
    padding: 6px;
    color: #333333;
    selection-background-color: #d8b4e2;
}
QTextEdit#AiInputEdit:focus {
    border: 1px solid #8b5cf6;
}
QPushButton#AiClearBtn {
    background-color: #ffffff;
    color: #666666;
    border: 1px solid #d1d1e0;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton#AiClearBtn:hover {
    background-color: #f3f4f6;
    color: #333333;
}
QPushButton#AiCopyAllBtn {
    background-color: #eef2ff;
    color: #4338ca;
    border: 1px solid #c7d2fe;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
}
QPushButton#AiCopyAllBtn:hover {
    background-color: #e0e7ff;
}
QPushButton#AiSendBtn {
    background-color: #8b5cf6;
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: bold;
}
QPushButton#AiSendBtn:hover {
    background-color: #7c3aed;
}

/* ================= Calculator 模块 ================= */
QPushButton#CalcTabBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 8px 18px;
    min-height: 28px;
    color: #6B7080;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#CalcTabBtn:hover {
    background-color: #F1EDFF;
    color: #6C5CE7;
}
QPushButton#CalcTabBtn:checked {
    background-color: #E6DFFF;
    color: #6C5CE7;
    border-color: #8B7BFF;
    font-weight: 700;
}

QTextBrowser#CalcHistory {
    background-color: #FBFAFF;
    border: 1px solid #E4E0F2;
    border-radius: 12px;
    padding: 12px 16px;
    color: #1F2033;
    selection-background-color: #8B7BFF;
    selection-color: #FFFFFF;
}

QFrame#CalcInputCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E0F2;
    border-radius: 12px;
}

QPlainTextEdit#CalcInput {
    background-color: #F6F4FD;
    border: 1px solid #D9D3EE;
    border-radius: 8px;
    padding: 8px 12px;
    color: #1F2033;
    selection-background-color: #8B7BFF;
    selection-color: #FFFFFF;
}
QPlainTextEdit#CalcInput:focus {
    border-color: #8B7BFF;
}

QLabel#CalcVarsLabel {
    color: #8A8FA3;
    font-size: 12px;
    padding-left: 4px;
}

/* --- 格式切换 / 小数位控件 --- */
QComboBox#CalcFmtCombo {
    background-color: #FFFFFF;
    border: 1px solid #D9D3EE;
    border-radius: 6px;
    padding: 4px 10px;
    min-width: 64px;
    color: #1F2033;
}
QComboBox#CalcFmtCombo:hover         { border-color: #8B7BFF; }
QComboBox#CalcFmtCombo::drop-down    { border: none; width: 16px; }
QComboBox#CalcFmtCombo QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F2033;
    selection-background-color: #E6DFFF;
    selection-color: #6C5CE7;
    border: 1px solid #D9D3EE;
    border-radius: 6px;
    padding: 4px 0;
}
QSpinBox#CalcDecSpin {
    background-color: #FFFFFF;
    border: 1px solid #D9D3EE;
    border-radius: 6px;
    padding: 3px 6px;
    color: #1F2033;
}
QSpinBox#CalcDecSpin:focus           { border-color: #8B7BFF; }
QSpinBox#CalcDecSpin:disabled        { color: #B2B7C9; border-color: #ECEAF6; }

/* --- 帮助对话框 --- */
QDialog#CalcHelpDialog {
    background-color: #F7F5FD;
}
QTextBrowser#CalcHelpView {
    background-color: #FFFFFF;
    border: 1px solid #E4E0F2;
    border-radius: 10px;
    padding: 10px 14px;
    color: #1F2033;
    selection-background-color: #8B7BFF;
    selection-color: #FFFFFF;
}
